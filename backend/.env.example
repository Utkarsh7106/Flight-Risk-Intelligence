# Copy to .env and fill in for local development. Never commit the real .env.

# Runtime connection — must be the RLS-restricted role, not the table owner.
# See db/roles.sql for why this matters.
DATABASE_URL=postgresql+psycopg://fri_app:fri_app_dev_pw@localhost:5432/fri_dev

# Migrations connect as the table owner instead (set this when running alembic).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://fri_migrator:fri_migrator_dev_pw@localhost:5432/fri_dev

# openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-secret-for-any-non-local-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# "local" relaxes the auth cookie to SameSite=Lax / non-Secure so login
# works over plain http://localhost. Leave unset (defaults to "production",
# i.e. SameSite=None + Secure) on any deployed build — Render/Railway must
# NOT set this. See app/config.py.
ENVIRONMENT=local

# Comma-separated explicit origin allowlist. Never "*". In production this
# is the deployed frontend's Vercel/Netlify URL.
CORS_ORIGINS=http://localhost:5173

# PDF export (Module 4) uses Playwright's headless Chromium. Leave this
# UNSET everywhere except a dev sandbox with a nonstandard preinstalled
# Chromium path — the normal setup is `playwright install chromium` (see
# backend/README.md), which needs no path override at all.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
